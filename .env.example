# Kosongkan APP_PASSWORD untuk menonaktifkan login (hanya untuk pemakaian lokal).
APP_PASSWORD=ganti-dengan-kata-sandi-kuat
# Acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Set true jika diakses lewat HTTPS (wajib di VPS dengan domain/HTTPS)
COOKIE_SECURE=true
